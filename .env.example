# Configuración MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=cine_paradiso

AUTO_MIGRATE=true
# Solo desarrollo local: crea una compra de prueba para validar el QR.
AUTO_SEED=false

# Clave secreta para encriptar los Tokens JWT (generar una clave segura para producción)
JWT_SECRET_KEY=tu_jwt_secret_key
SUPER_ADMIN_EMAIL=cine_paradiso@admin.com

# Generar una clave aleatoria de al menos 32 caracteres antes de iniciar.
PASSWORD_RESET_URL=http://localhost:3000/auth/restablecer-contrasena
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@cine-paradiso.local
SMTP_USERNAME=
SMTP_PASSWORD=
# Solo deshabilitar TLS para un servidor de correo local de desarrollo.
SMTP_STARTTLS=true

# API TMDB
TMDB_API_KEY=tu_api_key_tmdb
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Configuración de Correo (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=cineparadiso.test@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
